VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional SSR equivalents
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional overrides for the configured PostHog US Cloud project (production only).
# Leave commented to use the defaults. An explicitly empty key disables tracking.
# Use a public project token, never a personal API key.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional override for the configured Sentry project. Empty explicitly disables it.
# VITE_SENTRY_DSN=
# Set to the deployed commit SHA or release version.
VITE_SENTRY_RELEASE=
